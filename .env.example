MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust
SESSION_SECRET=replace-this-with-a-long-random-secret
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# In production, set SESSION_SECRET to at least 32 random bytes.
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production trusts one HTTPS-terminating reverse proxy; adjust app.js if your topology differs.
IMAGE_STORAGE=local
IMAGE_UPLOAD_DIRECTORY=public/uploads
# Cloudflare R2 (used when IMAGE_STORAGE=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generic S3-compatible storage (used when IMAGE_STORAGE=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=your-verified-sender@example.com
