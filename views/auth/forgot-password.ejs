<% layout("layouts/boilerplate") %>

<div class="form-container auth-container">
  <h1>Recover your account</h1>
  <p>Enter your account email to receive a recovery code for your username and password.</p>

  <% if (error) { %>
    <p class="form-error" role="alert"><%= error %></p>
  <% } %>

  <form action="/forgot-password" method="POST">
    <label for="email">Email</label>
    <input id="email" type="email" name="email" value="<%= values.email || "" %>" maxlength="254" autocomplete="email" required autofocus>
    <button type="submit">Send recovery code</button>
  </form>

  <p class="auth-switch"><a href="/login">Back to log in</a></p>
</div>
