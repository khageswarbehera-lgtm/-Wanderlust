<% layout("layouts/boilerplate") %>

<div class="form-container">

  <h1>Create New Listing</h1>

  <form action="/listings" method="POST" id="listing-form" enctype="multipart/form-data" novalidate>

    <label for="title">Title</label>
    <input
      type="text"
      name="title"
      id="title"
      placeholder="Enter listing title"
      value="<%= listing.title || "" %>"
      required
    >
    <p class="field-error" id="title-error" data-field="title" <%= errors.title ? "" : "hidden" %> role="alert"><%= errors.title || "" %></p>

    <label for="description">Description</label>
    <textarea
      name="description"
      id="description"
      placeholder="Describe the place"
      required
    ><%= listing.description || "" %></textarea>
    <p class="field-error" id="description-error" data-field="description" <%= errors.description ? "" : "hidden" %> role="alert"><%= errors.description || "" %></p>

    <label for="price">Price</label>
    <input
      type="number"
      name="price"
      id="price"
      placeholder="Enter price"
      value="<%= listing.price ?? "" %>"
      min="0"
      step="any"
      required
    >
    <p class="field-error" id="price-error" data-field="price" <%= errors.price ? "" : "hidden" %> role="alert"><%= errors.price || "" %></p>

    <label for="image">Listing image</label>
    <input
      type="file"
      name="image"
      id="image"
      accept="image/jpeg,image/png,image/gif,image/webp"
      required
      aria-describedby="image-upload-status image-error"
    >
    <p class="upload-status" id="image-upload-status" data-upload-status role="status" aria-live="polite"><%= uploadMessage %></p>
    <p class="field-error" id="image-error" data-field="image" <%= errors.image ? "" : "hidden" %> role="alert"><%= errors.image || "" %></p>

    <label for="location">Location</label>
    <input
      type="text"
      name="location"
      id="location"
      placeholder="Enter location"
      value="<%= listing.location || "" %>"
      required
    >
    <p class="field-error" id="location-error" data-field="location" <%= errors.location ? "" : "hidden" %> role="alert"><%= errors.location || "" %></p>

    <label for="country">Country</label>
    <input
      type="text"
      name="country"
      id="country"
      placeholder="Enter country"
      value="<%= listing.country || "" %>"
      required
    >
    <p class="field-error" id="country-error" data-field="country" <%= errors.country ? "" : "hidden" %> role="alert"><%= errors.country || "" %></p>

    <button type="submit">
      Create Listing
    </button>

  </form>

</div>
