<% layout("layouts/boilerplate") %>

<div class="form-container">

  <h1>Create New Listing</h1>

  <form action="/listings" method="POST" id="listing-form" enctype="multipart/form-data" novalidate>

    <label>Title</label>
    <input
      type="text"
      name="title"
      placeholder="Enter listing title"
      value="<%= listing.title || "" %>"
      required
    >
    <p class="field-error" data-field="title" <%= errors.title ? "" : "hidden" %>><%= errors.title || "" %></p>

    <label>Description</label>
    <textarea
      name="description"
      placeholder="Describe the place"
      required
    ><%= listing.description || "" %></textarea>
    <p class="field-error" data-field="description" <%= errors.description ? "" : "hidden" %>><%= errors.description || "" %></p>

    <label>Price</label>
    <input
      type="number"
      name="price"
      placeholder="Enter price"
      value="<%= listing.price ?? "" %>"
      min="0"
      step="any"
      required
    >
    <p class="field-error" data-field="price" <%= errors.price ? "" : "hidden" %>><%= errors.price || "" %></p>

    <label for="image">Listing image</label>
    <input
      type="file"
      name="image"
      id="image"
      accept="image/*"
      required
    >
    <p class="field-error" data-field="image" <%= errors.image ? "" : "hidden" %>><%= errors.image || "" %></p>

    <label>Location</label>
    <input
      type="text"
      name="location"
      placeholder="Enter location"
      value="<%= listing.location || "" %>"
      required
    >
    <p class="field-error" data-field="location" <%= errors.location ? "" : "hidden" %>><%= errors.location || "" %></p>

    <label>Country</label>
    <input
      type="text"
      name="country"
      placeholder="Enter country"
      value="<%= listing.country || "" %>"
      required
    >
    <p class="field-error" data-field="country" <%= errors.country ? "" : "hidden" %>><%= errors.country || "" %></p>

    <button type="submit">
      Create Listing
    </button>

  </form>

</div>
