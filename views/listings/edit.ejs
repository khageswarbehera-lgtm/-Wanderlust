<% layout("layouts/boilerplate") %>

<div class="form-container">

  <h1>Edit Listing</h1>

  <form
    action="/listings/<%= listing._id %>?_method=PUT"
    method="POST"
    enctype="multipart/form-data"
    id="listing-form"
    novalidate
  >

    <label for="title">Title</label>

    <input
      type="text"
      name="title"
      id="title"
      value="<%= listing.title %>"
      required
    >
    <p class="field-error" id="title-error" data-field="title" <%= errors.title ? "" : "hidden" %> role="alert"><%= errors.title || "" %></p>


    <label for="description">Description</label>

    <textarea name="description" id="description" required><%= listing.description %></textarea>
    <p class="field-error" id="description-error" data-field="description" <%= errors.description ? "" : "hidden" %> role="alert"><%= errors.description || "" %></p>


    <label for="price">Price</label>

    <input
      type="number"
      name="price"
      id="price"
      value="<%= listing.price %>"
      min="0"
      step="any"
      required
    >
    <p class="field-error" id="price-error" data-field="price" <%= errors.price ? "" : "hidden" %> role="alert"><%= errors.price || "" %></p>


    <label for="image">Replace image (optional)</label>

    <input
      type="file"
      name="image"
      id="image"
      accept="image/jpeg,image/png,image/gif,image/webp"
    >
    <img src="<%= listing.image %>" alt="Current listing image" class="current-image-preview">
    <p class="upload-status" id="image-upload-status" data-upload-status role="status" aria-live="polite">No replacement selected.</p>
    <p class="field-error" id="image-error" data-field="image" <%= errors.image ? "" : "hidden" %> role="alert"><%= errors.image || "" %></p>


    <label for="location">Location</label>

    <input
      type="text"
      name="location"
      id="location"
      value="<%= listing.location %>"
      required
    >
    <p class="field-error" id="location-error" data-field="location" <%= errors.location ? "" : "hidden" %> role="alert"><%= errors.location || "" %></p>


    <label for="country">Country</label>

    <input
      type="text"
      name="country"
      id="country"
      value="<%= listing.country %>"
      required
    >
    <p class="field-error" id="country-error" data-field="country" <%= errors.country ? "" : "hidden" %> role="alert"><%= errors.country || "" %></p>


    <button type="submit">
      Update Listing
    </button>

  </form>

</div>
