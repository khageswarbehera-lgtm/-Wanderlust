<% layout("layouts/boilerplate") %>

<div class="listing-header">

  <h1>Explore Listings</h1>

  

</div>


<div class="listing-container">

  <% if (listings.length) { %>
    <% listings.forEach(listing => { %>

    <div class="listing-card">

        <a href="/listings/<%= listing._id %>" class="listing-image-link">


      <img
        src="<%= listing.image %>"
        alt="<%= listing.title %>"
      >

        </a>

      <div class="listing-content">

        <a href="/listings/<%= listing._id %>" class="title-link">

          <h2 class="listing-title">
            <%= listing.title %>
          </h2>

        </a>

        <p class="location">
          📍 <%= listing.location %>,
          <%= listing.country %>
        </p>

        <p class="description">
          <%= listing.description %>
        </p>

        <p class="price">
         ₹<%= listing.price.toLocaleString("en-IN") %>
          <span>/ night</span>
        </p>

      </div>

    </div>

    <% }) %>
  <% } else { %>
    <section class="empty-state" aria-labelledby="empty-listings-title">
      <h2 id="empty-listings-title">No listings yet</h2>
      <p>Be the first to share a place worth discovering.</p>
      <a href="/listings/new" class="create-btn">Create a listing</a>
    </section>
  <% } %>

</div>
